# Add to your existing Caddyfile on the Stacksift VPS, or include as
# /etc/caddy/sites/nepalgov.datacortex.in.caddy and reference from main config.
#
# Caddy auto-provisions Let's Encrypt certs. Make sure the DNS A record
# for nepalgov.datacortex.in points to this VPS before reloading Caddy.

nepalgov.datacortex.in {
	encode zstd gzip

	# Gradio uses WebSockets for queue + streaming; the default reverse_proxy
	# handles upgrades correctly, but we make it explicit for clarity.
	reverse_proxy 127.0.0.1:7860 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Basic security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Gradio inlines scripts/styles; keep CSP permissive for the demo.
		# Remove or tighten if you replace Gradio with a custom frontend.
		-Server
	}

	# Light access log to its own file; rotate via logrotate.
	log {
		output file /var/log/caddy/nepalgov.access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format console
	}
}
