# Nepal GovAgent — environment variables
# Copy this file to .env and fill in your values

# Required for answer generation with citations (optional — library works offline without this)
MISTRAL_API_KEY=your_mistral_api_key_here

# Required for synthetic eval generation (`python -m nepal_gov_agent.eval.generate`)
OPENAI_API_KEY=your_openai_api_key_here

# Required only for PyPI publishing (maintainers only)
TWINE_USERNAME=your_pypi_username
TWINE_PASSWORD=your_pypi_password
